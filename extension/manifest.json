{
  "manifest_version": 3,
  "name": "FocusPet",
  "version": "1.1.0",
  "description": "Grow a tiny cat or bunny with each focus session. A cute Pomodoro companion with persistent timers, streaks, and gentle reminders.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusPet"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
