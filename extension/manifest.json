{
  "manifest_version": 3,
  "name": "FocusPet",
  "version": "1.2.0",
  "description": "Start a 5, 15, or 25-minute focus session with a tiny cat or bunny. No setup, pet chores, or account required.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusPet"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
