{
  "manifest_version": 3,
  "name": "FocusPet: Focus Timer & Virtual Pet",
  "version": "1.2.1",
  "description": "A focus timer with a virtual cat or bunny. Choose 5, 15, or 25 minutes, complete sessions, and unlock pet accessories.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusPet"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "short_name": "FocusPet"
}
