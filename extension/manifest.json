{
  "manifest_version": 3,
  "name": "FocusPebble",
  "version": "1.0.0",
  "description": "A simple focus and break timer with browser notifications. Keep your timer across restarts and build a daily focus habit.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusPebble"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
